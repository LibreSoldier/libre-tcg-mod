<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <AssemblyName>LibreTcgMod</AssemblyName>
    <RootNamespace>LibreTcgMod</RootNamespace>
    <Version>1.1.0</Version>
    <!-- Shown by the launcher in the mod's details (AssemblyDescription). -->
    <Description>The base for other mods: lets server plugins and client mods talk to each other, and tells mods about the connection, chat rooms and matches. Includes a debug panel (F9) for mod authors.</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Folder of the PTCGO client with BepInEx installed; override with -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/Games/ptcgo/drive_c/users/$(USER)/AppData/Roaming/Pokémon Trading Card Game Online/PokemonTradingCardGameOnline-Modded</GameDir>
    <ManagedDir>$(GameDir)/Pokemon Trading Card Game Online_Data/Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Compiled against the game's and BepInEx's DLLs; none of them are copied or shipped. -->
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(GameDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="core" HintPath="$(ManagedDir)/core.dll" Private="false" />
    <Reference Include="pie-src" HintPath="$(ManagedDir)/pie-src.dll" Private="false" />
    <Reference Include="FreeTypeInterop" HintPath="$(ManagedDir)/FreeTypeInterop.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shown by the launcher next to the mod's name (AssemblyMetadata "Logo"). -->
    <AssemblyMetadata Include="Logo" Value="https://raw.githubusercontent.com/LibreSoldier/libre-tcg-mod/main/logo.png" />
  </ItemGroup>
</Project>
